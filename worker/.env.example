# Redis (Upstash) - usar la URL "rediss://" con TLS del dashboard de Upstash
REDIS_URL=rediss://default:password@host:6379

# Resend
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=DentalPrime <onboarding@resend.dev>

# Secreto compartido con la Edge Function notificar-reserva.
# Generar uno random (ej: openssl rand -hex 32) y configurarlo igual en:
#   supabase secrets set WORKER_API_SECRET=<mismo valor>
WORKER_API_SECRET=cambiar_este_valor

PORT=3000
